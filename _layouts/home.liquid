---
layout: default
---
{% assign p = site.data.profile %}

<div class="sx-home">
  <!-- Hero -->
  <section class="sx-hero" aria-labelledby="hero-name">
    <div class="sx-hero-text">
      <p class="sx-eyebrow">{{ page.hero.eyebrow }}</p>
      <h1 class="sx-hero-name" id="hero-name">{{ p.name }}</h1>

      <div class="sx-native">
        <span lang="bn">{{ p.native_name }}</span>
        <button
          class="sx-pronounce"
          type="button"
          data-audio="{{ p.pronunciation | relative_url }}"
          title="Listen to the pronunciation of my name"
          aria-label="Listen to the pronunciation of {{ p.name }}"
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 10v4a1 1 0 0 0 1 1h3l4 4V5L7 9H4a1 1 0 0 0-1 1Zm13.5 2A4.5 4.5 0 0 0 14 8v8a4.47 4.47 0 0 0 2.5-4ZM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54Z"/>
          </svg>
        </button>
        {% include flag-india.svg %}
      </div>

      <p class="sx-hero-role">
        {{ p.role -}}
        <br>
        <a href="{{ p.university_url }}">{{ p.university }}</a>
      </p>
      <p class="sx-hero-affil">
        {{ p.chair }} · Group of <a href="{{ p.group_lead_url }}">{{ p.group_lead }}</a>
      </p>

      <p class="sx-hero-lead">{{ page.hero.lead }}</p>

      <div class="sx-hero-actions">
        <a class="sx-btn sx-btn-primary" href="{{ '/research/' | relative_url }}">Explore research <span aria-hidden="true">→</span></a>
        <a class="sx-btn" href="{{ '/publications/' | relative_url }}">Publications</a>
      </div>

      <ul class="sx-hero-links" aria-label="Profiles and contact">
        <li>
          <a href="{{ p.links.scholar }}"><i class="ai ai-google-scholar" aria-hidden="true"></i> Google Scholar</a>
        </li>
        <li>
          <a href="{{ p.links.github }}"><i class="fa-brands fa-github" aria-hidden="true"></i> GitHub</a>
        </li>
        <li>
          <a href="{{ p.links.linkedin }}"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i> LinkedIn</a>
        </li>
        <li>
          <a href="mailto:{{ p.email }}"><i class="fa-solid fa-envelope" aria-hidden="true"></i> Email</a>
        </li>
      </ul>
    </div>

    <div class="sx-hero-visual">
      <svg class="sx-lattice" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
        <defs>
          <pattern id="sx-dots" width="25" height="25" patternUnits="userSpaceOnUse">
            <circle cx="12.5" cy="12.5" r="1.6"></circle>
          </pattern>
          <linearGradient id="sx-arc" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" style="stop-color: var(--sx-accent)"></stop>
            <stop offset="1" style="stop-color: var(--sx-accent-2)"></stop>
          </linearGradient>
        </defs>
        <rect class="sx-lattice-dots" width="400" height="400" fill="url(#sx-dots)"></rect>
        <rect class="sx-lattice-bz" x="62.5" y="62.5" width="275" height="275" transform="rotate(45 200 200)"></rect>
        <path class="sx-lattice-arc" d="M 40 120 Q 200 230 360 120" stroke="url(#sx-arc)"></path>
        <path class="sx-lattice-arc" d="M 40 280 Q 200 170 360 280" stroke="url(#sx-arc)"></path>
      </svg>
      <figure class="sx-portrait">
        <img src="{{ p.portrait | relative_url }}" alt="Portrait of {{ p.name }}" width="395" height="395" loading="eager">
      </figure>
    </div>
  </section>

  <!-- Research areas -->
  <section class="sx-section sx-reveal" aria-labelledby="areas-title">
    <div class="sx-section-head">
      <div>
        <p class="sx-kicker">Research</p>
        <h2 class="sx-section-title" id="areas-title">Research Areas</h2>
      </div>
      <a class="sx-more" href="{{ '/research/' | relative_url }}">Research overview <span aria-hidden="true">→</span></a>
    </div>
    <div class="sx-areas">
      {% for area in page.areas %}
        {% assign fig = site.data.image_credits | where: 'id', area.figure | first %}
        <a class="sx-area" href="{{ area.link | relative_url }}">
          <div class="sx-area-media">
            <img src="{{ fig.card | relative_url }}" alt="{{ fig.alt | strip }}" loading="lazy" decoding="async">
            <span class="sx-chip">Schematic</span>
          </div>
          <div class="sx-area-body">
            <span class="sx-area-index">0{{ forloop.index }}</span>
            <h3>{{ area.title }}</h3>
            <p>{{ area.text }}</p>
            <span class="sx-area-go">Explore <span aria-hidden="true">→</span></span>
          </div>
        </a>
      {% endfor %}
    </div>
    <p class="sx-fineprint">
      Card images are schematic model visualizations generated from minimal tight-binding models, not research data.
      <a href="{{ '/image-credits/' | relative_url }}">Models and credits</a>.
    </p>
  </section>

  <!-- Selected publications -->
  <section class="sx-section sx-reveal" aria-labelledby="papers-title">
    <div class="sx-section-head">
      <div>
        <p class="sx-kicker">Publications</p>
        <h2 class="sx-section-title" id="papers-title">Selected Publications</h2>
      </div>
      <a class="sx-more" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">→</span></a>
    </div>
    <div class="publications sx-selected">
      {% bibliography --group_by none --query @*[selected=true]* %}
    </div>
  </section>

  <!-- News -->
  {% if site.news != blank %}
    <section class="sx-section sx-news-section sx-reveal" aria-labelledby="news-title">
      <div class="sx-section-head">
        <div>
          <p class="sx-kicker">Updates</p>
          <h2 class="sx-section-title sx-section-title-sm" id="news-title">News</h2>
        </div>
        <a class="sx-more" href="{{ '/news/' | relative_url }}">All news <span aria-hidden="true">→</span></a>
      </div>
      <ol class="sx-news">
        {% assign news = site.news | reverse %}
        {% for item in news limit: 3 %}
          <li>
            <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
            <div>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' }}
              {% else %}
                <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </section>
  {% endif %}
</div>
